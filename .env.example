VITE_API_URL=http://localhost:3000/api

# Mapbox — geocodificación y mapa estático (token público pk.*)
# Obtener en: https://account.mapbox.com/access-tokens/
# Si falta, la geocodificación usa Nominatim/OpenStreetMap como fallback.
VITE_MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxxxxxx

# Google Maps — mapa visible (Maps Embed API) cuando no hay token de Mapbox.
# Obtener en: https://console.cloud.google.com/ (habilitar "Maps Embed API").
# Key pública: restringir por referente HTTP (dominios de la app) y por API.
VITE_GOOGLE_MAPS_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
